# Pin CI to SwiftFormat 0.62.1. Run:
#   swiftformat --config .swiftformat PiMPAudioStudio PiMPAudioStudioTests PiMPAudioCore
# wrap and wrapArguments time out on large files on Ubuntu (AppStateTests ~4k lines).
--swiftversion 5.10
--indent 4
--maxwidth 120
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--trimwhitespace always
--stripunusedargs closure-only
--disable wrapMultilineStatementBraces
--disable wrap
--disable wrapArguments
--disable noForceUnwrapInTests
--disable noForceTryInTests
--exclude .build,DerivedData,Vendor,Spikes
