def preferred_worker_python(workdir: Path) -> Path:
    managed_python = workdir / "venv/bin/python"
    if managed_python.exists():
        return Path(os.path.abspath(os.fspath(managed_python)))
    configured_python = os.environ.get("PIMP_REMOTE_PYTHON", "").strip()
    if configured_python:
        return Path(os.path.abspath(os.fspath(Path(configured_python).expanduser())))
    return Path(os.path.abspath(os.fspath(managed_python)))


def maybe_reexec_worker_python() -> None:
    if os.environ.get("PIMP_REMOTE_WORKER_NO_REEXEC") == "1":
        return

    workdir = Path(os.environ.get("PIMP_REMOTE_WORKDIR", str(DEFAULT_WORKDIR))).expanduser()
    target = preferred_worker_python(workdir)
    if not target.exists():
        return

    try:
        current = Path(os.path.abspath(os.fspath(Path(sys.executable).expanduser())))
        absolute_target = Path(os.path.abspath(os.fspath(target.expanduser())))
    except OSError:
        return

    if current == absolute_target:
        return

    env = os.environ.copy()
    env["PIMP_REMOTE_WORKER_REEXEC"] = "1"
    env["PIMP_REMOTE_PYTHON"] = str(absolute_target)
    os.execvpe(str(absolute_target), [str(absolute_target), str(Path(__file__).absolute()), *sys.argv[1:]], env)


maybe_reexec_worker_python()


def default_jobs_dir() -> Path:
    override = os.environ.get("PIMP_REMOTE_JOB_DIR")
    if override:
        return Path(override).expanduser()
    workspace = Path("/workspace")
    if workspace.exists() and os.access(workspace, os.W_OK):
        return workspace / "pimp-remote-jobs/current"
    return Path("/tmp/pimp-remote-jobs/current")


def utc_now() -> str:
    return _dt.datetime.now(_dt.timezone.utc).isoformat().replace("+00:00", "Z")


def read_json(path: Path) -> dict[str, Any]:
    with path.open("r", encoding="utf-8") as handle:
        value = json.load(handle)
    if not isinstance(value, dict):
        raise ValueError(f"{path} must contain a JSON object")
    return value


def write_json(path: Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8") as handle:
        json.dump(payload, handle, indent=2, sort_keys=True)
        handle.write("\n")


def append_jsonl(path: Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        json.dump(payload, handle, sort_keys=True)
        handle.write("\n")


def shell_join(args: list[str]) -> str:
    return shlex.join([str(arg) for arg in args])


def safe_name(raw: str) -> str:
    cleaned = re.sub(r"[^A-Za-z0-9._-]+", "-", raw.strip())
    return cleaned.strip("-._") or "pimp-remote-job"


def resolve_package_path(root: Path, raw: Any, label: str, *, allow_root: bool = False) -> Path:
    if not isinstance(raw, str) or not raw.strip():
        raise ValueError(f"{label} must be a non-empty relative path")
    relative = Path(raw)
    if relative.is_absolute():
        raise ValueError(f"{label} must be relative to the package root")

    resolved_root = root.resolve()
    candidate = (resolved_root / relative).resolve()
    if not candidate.is_relative_to(resolved_root) or (candidate == resolved_root and not allow_root):
        raise ValueError(f"{label} escapes the package root: {raw!r}")
    return candidate


def paths_overlap(first: Path, second: Path) -> bool:
    first = first.resolve()
    second = second.resolve()
    return first == second or first.is_relative_to(second) or second.is_relative_to(first)


def relative_path(path: Path, root: Path) -> str:
    return path.resolve().relative_to(root.resolve()).as_posix()


def validate_zip_members(archive: zipfile.ZipFile, destination: Path) -> None:
    root = destination.resolve()
    for member in archive.infolist():
        member_path = Path(member.filename)
        if member_path.is_absolute():
            raise ValueError(f"Zip member uses an absolute path: {member.filename!r}")
        candidate = (root / member_path).resolve()
        if not candidate.is_relative_to(root):
            raise ValueError(f"Zip member escapes the extraction directory: {member.filename!r}")
        mode = member.external_attr >> 16
        if stat.S_ISLNK(mode):
            raise ValueError(f"Zip member is a symbolic link: {member.filename!r}")


def first_string(*values: Any) -> str | None:
    for value in values:
        if isinstance(value, str) and value.strip():
            return value.strip()
    return None


def first_number(*values: Any) -> float | None:
    for value in values:
        if isinstance(value, (int, float)):
            return float(value)
        if isinstance(value, str):
            try:
                return float(value)
            except ValueError:
                continue
    return None


def coerce_int(value: Any, default: int) -> int:
    if value is None or value == "":
        return default
    return int(value)


def coerce_float(value: Any, default: float) -> float:
    if value is None or value == "":
        return default
    return float(value)


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def find_remote_job(root: Path) -> Path:
    if root.is_file() and root.name == "remote_job.json":
        return root.resolve()
    if root.is_file() and root.suffix.lower() == ".zip":
        target = default_jobs_dir() / safe_name(root.stem)
        with zipfile.ZipFile(root) as archive:
            validate_zip_members(archive, target)
            if target.exists():
                shutil.rmtree(target)
            target.mkdir(parents=True, exist_ok=True)
            archive.extractall(target)
        return find_remote_job(target)
    if root.is_dir():
        direct = root / "remote_job.json"
        if direct.is_file():
            return direct.resolve()
        wrappers = [
            child / "remote_job.json"
            for child in sorted(root.iterdir())
            if child.is_dir() and (child / "remote_job.json").is_file()
        ]
        if len(wrappers) == 1:
            return wrappers[0].resolve()
    raise FileNotFoundError(
        f"Could not find remote_job.json at the package root of {root}"
    )


def normalize_variant(raw: str | None) -> str:
    lower = (raw or "").lower().replace("_", "-")
    if "xl" in lower:
        if "turbo" in lower:
            return "acestep-v15-xl-turbo"
        if "base" in lower:
            return "acestep-v15-xl-base"
        return "acestep-v15-xl-sft"
    if "sft" in lower:
        return "acestep-v15-sft"
    if "base" in lower or "full" in lower:
        return "acestep-v15-base"
    return "acestep-v15-turbo"


def base_model_for_variant(variant: str) -> str:
    lower = variant.lower()
    if "turbo" in lower:
        return "turbo"
    if "sft" in lower:
        return "sft"
    return "base"


def schedule_for_variant(variant: str) -> tuple[float, int]:
    if "turbo" in variant.lower():
        return 3.0, 8
    return 1.0, 50


def variant_repo(variant: str) -> str:
    return {
        "acestep-v15-xl-sft": "ACE-Step/acestep-v15-xl-sft",
        "acestep-v15-xl-base": "ACE-Step/acestep-v15-xl-base",
        "acestep-v15-xl-turbo": "ACE-Step/acestep-v15-xl-turbo",
        "acestep-v15-sft": "ACE-Step/acestep-v15-sft",
        "acestep-v15-base": "ACE-Step/acestep-v15-base",
        "acestep-v15-turbo": "ACE-Step/Ace-Step1.5",
    }.get(variant, f"ACE-Step/{variant}")


def contains_weights(path: Path) -> bool:
    if not path.is_dir():
        return False
    names = {
        "model.safetensors",
        "model.safetensors.index.json",
        "pytorch_model.bin",
        "pytorch_model.bin.index.json",
        "diffusion_pytorch_model.safetensors",
        "diffusion_pytorch_model.safetensors.index.json",
    }
    return any((path / name).exists() for name in names)


def sanitize_precision(raw: str | None, fallback: str) -> str:
    precision = (raw or fallback).strip().lower()
    if precision not in {"bf16", "fp16", "fp32"}:
        return fallback
    return precision


def resolve_precisions(raw: str | None) -> tuple[str, str]:
    precision = (raw or "bf16_or_fp16").strip().lower()
    if precision in {"bf16_or_fp16", "auto"}:
        preprocess = sanitize_precision(
            os.environ.get("PIMP_REMOTE_PREPROCESS_PRECISION") or os.environ.get("PIMP_REMOTE_PRECISION"),
            "fp16",
        )
        training = sanitize_precision(os.environ.get("PIMP_REMOTE_TRAINING_PRECISION"), "bf16")
        return preprocess, training
    resolved = sanitize_precision(precision, "bf16")
    return resolved, resolved


class RemoteWorker:
    def __init__(self, args: argparse.Namespace):
        self.args = args
        self.job_path = find_remote_job(Path(args.job).expanduser().resolve())
        self.job = read_json(self.job_path)
        self.package_root = self.resolve_package_root()
        outputs = self.job.get("outputs") if isinstance(self.job.get("outputs"), dict) else {}
        self.logs_file = resolve_package_path(
            self.package_root,
            outputs.get("logs_file", "remote_artifacts/logs.jsonl"),
            "outputs.logs_file",
        )
        self.metrics_file = resolve_package_path(
            self.package_root,
            outputs.get("metrics_file", "remote_artifacts/metrics.jsonl"),
            "outputs.metrics_file",
        )
        self.result_file = resolve_package_path(
            self.package_root,
            outputs.get("result_file", "remote_artifacts/result.json"),
            "outputs.result_file",
        )
        self.checkpoints_dir = resolve_package_path(
            self.package_root,
            outputs.get("checkpoints_directory", "remote_artifacts/checkpoints"),
            "outputs.checkpoints_directory",
        )
        self.final_adapter_dir = resolve_package_path(
            self.package_root,
            outputs.get("final_adapter_directory", "remote_artifacts/final_adapter"),
            "outputs.final_adapter_directory",
        )
        self.artifacts_dir = self.result_file.parent
        self.validate_output_layout()
        self.command_dir = self.artifacts_dir / "command"
        self.tensor_dir = self.artifacts_dir / "tensors"
        self.output_dir = self.artifacts_dir / "side_step_output"
        self.preprocess_placeholder = self.artifacts_dir / "preprocess_placeholder"
        self.preprocess_audio_dir = self.artifacts_dir / "preprocess_audio"
        self.side_step_dataset = self.artifacts_dir / "side_step_dataset.json"
        self.dataset_selection: dict[str, Any] = {}
        self.started_at: str | None = None
        self.artifacts_dir.mkdir(parents=True, exist_ok=True)
        self.command_dir.mkdir(parents=True, exist_ok=True)

    def resolve_package_root(self) -> Path:
        package = self.job.get("package") if isinstance(self.job.get("package"), dict) else {}
        raw_root = package.get("package_root", ".")
        root = resolve_package_path(
            self.job_path.parent,
            raw_root,
            "package.package_root",
            allow_root=True,
        )
        expected_root = self.job_path.parent.resolve()
        if root != expected_root:
            raise ValueError("package.package_root must resolve to the directory containing remote_job.json")
        return root

    def validate_output_layout(self) -> None:
        if self.artifacts_dir == self.package_root:
            raise ValueError("outputs.result_file must be inside a dedicated artifacts directory")

        output_paths = {
            "outputs.logs_file": self.logs_file,
            "outputs.metrics_file": self.metrics_file,
            "outputs.result_file": self.result_file,
            "outputs.checkpoints_directory": self.checkpoints_dir,
            "outputs.final_adapter_directory": self.final_adapter_dir,
        }
        for label, path in output_paths.items():
            if path == self.artifacts_dir or not path.is_relative_to(self.artifacts_dir):
                raise ValueError(f"{label} must stay below {self.artifacts_dir}")

        file_paths = [self.logs_file, self.metrics_file, self.result_file]
        if len(set(file_paths)) != len(file_paths):
            raise ValueError("Log, metrics, and result files must use distinct paths")
        if paths_overlap(self.checkpoints_dir, self.final_adapter_dir):
            raise ValueError("Checkpoint and final-adapter directories must not overlap")
        for file_path in file_paths:
            for output_directory in [self.checkpoints_dir, self.final_adapter_dir]:
                if paths_overlap(file_path, output_directory):
                    raise ValueError(f"Output file overlaps replaceable directory: {file_path}")

        reserved_staging = [
            self.artifacts_dir / "command",
            self.artifacts_dir / "tensors",
            self.artifacts_dir / "side_step_output",
            self.artifacts_dir / "preprocess_placeholder",
            self.artifacts_dir / "preprocess_audio",
        ]
        for output_directory in [self.checkpoints_dir, self.final_adapter_dir]:
            if any(paths_overlap(output_directory, reserved) for reserved in reserved_staging):
                raise ValueError(f"Output directory overlaps worker staging: {output_directory}")

    def log(self, stage: str, message: str, level: str = "info", **fields: Any) -> None:
        event = {
            "ts": utc_now(),
            "level": level,
            "stage": stage,
            "message": message,
            **fields,
        }
        append_jsonl(self.logs_file, event)
        print(f"[{level.upper()}] {stage}: {message}", flush=True)

    def metric(self, **fields: Any) -> None:
        append_jsonl(self.metrics_file, {"ts": utc_now(), **fields})

    def write_result(
        self,
        status: str,
        metrics: dict[str, float] | None = None,
        error: dict[str, Any] | None = None,
        extra_artifacts: list[dict[str, Any]] | None = None,
        include_training_artifacts: bool = True,
    ) -> None:
        artifacts: list[dict[str, Any]] = [
            {
                "kind": "logs",
                "path": relative_path(self.logs_file, self.package_root),
                "media_type": "application/x-ndjson",
            },
            {
                "kind": "metrics",
                "path": relative_path(self.metrics_file, self.package_root),
                "media_type": "application/x-ndjson",
            },
        ]
        if include_training_artifacts:
            artifacts = [
                {
                    "kind": "final_adapter",
                    "path": relative_path(self.final_adapter_dir, self.package_root),
                    "media_type": "application/vnd.pimp-audio.adapter",
                },
                {
                    "kind": "checkpoints",
                    "path": relative_path(self.checkpoints_dir, self.package_root),
                    "media_type": "inode/directory",
                },
                *artifacts,
            ]
        if extra_artifacts:
            artifacts.extend(extra_artifacts)
        result = {
            "pimp_audio_remote_result_version": "1.0",
            "job_id": self.job.get("job_id", "unknown"),
            "task": self.job.get("task", "unknown"),
            "status": status,
            "started_at": self.started_at,
            "finished_at": utc_now(),
            "artifacts": artifacts,
            "metrics": metrics or {},
        }
        training = self.job.get("training")
        if isinstance(training, dict):
            adapter_name = str(training.get("adapter_name") or "").strip()
            if adapter_name:
                result["adapter_name"] = adapter_name
        if error:
            result["error"] = error
        write_json(self.result_file, result)

    def selected_bundle_path(self) -> Path:
        package = self.job.get("package") if isinstance(self.job.get("package"), dict) else {}
        raw = package.get("entry_bundle") or (
            package.get("selected_bundle", {}).get("path")
            if isinstance(package.get("selected_bundle"), dict)
            else None
        )
        if not raw:
            raise ValueError("remote_job.json package.entry_bundle is missing")
        return resolve_package_path(self.package_root, raw, "package.entry_bundle")

    def selected_include(self) -> list[str]:
        package = self.job.get("package") if isinstance(self.job.get("package"), dict) else {}
        selected = package.get("selected_bundle") if isinstance(package.get("selected_bundle"), dict) else {}
        include = selected.get("include") if isinstance(selected.get("include"), list) else []
        return [str(item) for item in include]

    def dataset_manifest_path(self, bundle: dict[str, Any]) -> Path | None:
        package = self.job.get("package") if isinstance(self.job.get("package"), dict) else {}
        raw = first_string(package.get("dataset_manifest"))
        source_version = first_string(bundle.get("source_package_version"))
        if not raw and source_version and source_version.startswith("2."):
            raw = "dataset_manifest.json"
        if not raw:
            return None
        return resolve_package_path(self.package_root, raw, "package.dataset_manifest")

    def selected_clips(
        self,
        bundle: dict[str, Any],
        bundle_path: Path,
    ) -> tuple[list[dict[str, Any]], dict[str, Any]]:
        clips = bundle.get("clips")
        if not isinstance(clips, list) or not clips:
            raise ValueError(f"{bundle_path} does not contain clips")

        includes = [item.lower() for item in self.selected_include()]
        manifest_path = self.dataset_manifest_path(bundle)
        if manifest_path is None:
            selected = [
                clip for clip in clips
                if isinstance(clip, dict)
                and clip.get("include_in_training") is not False
                and (
                    not includes
                    or not first_string(clip.get("asset_role"))
                    or str(clip.get("asset_role")).lower() in includes
                )
            ]
            if not selected:
                raise ValueError("The selected training bundle does not contain any included assets")
            return selected, {
                "source_package_version": first_string(bundle.get("source_package_version"), "legacy"),
                "training_plan_id": first_string(bundle.get("training_plan_id")),
                "asset_roles": sorted({
                    str(clip.get("asset_role"))
                    for clip in selected
                    if first_string(clip.get("asset_role"))
                }),
                "asset_ids": [
                    first_string(clip.get("asset_id"), clip.get("id")) or ""
                    for clip in selected
                ],
                "training_ranges": [
                    clip.get("training_range")
                    for clip in selected
                    if isinstance(clip.get("training_range"), dict)
                ],
            }

        if not manifest_path.is_file():
            raise FileNotFoundError(f"Package-v2 manifest is missing: {manifest_path}")
        manifest = read_json(manifest_path)
        version = first_string(manifest.get("pimp_audio_dataset_version"))
        if version != "2.0":
            raise ValueError(
                f"Unsupported package-v2 manifest version {version or 'missing'}; expected 2.0"
            )
        assets = manifest.get("assets")
        plans = manifest.get("training_plans")
        if not isinstance(assets, list) or not assets:
            raise ValueError("dataset_manifest.json does not contain assets")
        if not isinstance(plans, list) or not plans:
            raise ValueError("dataset_manifest.json does not contain training_plans")

        assets_by_id: dict[str, dict[str, Any]] = {}
        for asset in assets:
            if not isinstance(asset, dict):
                continue
            asset_id = first_string(asset.get("asset_id"))
            if not asset_id:
                raise ValueError("dataset_manifest.json contains an asset without asset_id")
            if asset_id in assets_by_id:
                raise ValueError(f"dataset_manifest.json contains duplicate asset_id {asset_id}")
            assets_by_id[asset_id] = asset

        requested_plan_id = first_string(bundle.get("training_plan_id"))
        plan = next(
            (
                candidate for candidate in plans
                if isinstance(candidate, dict)
                and requested_plan_id
                and first_string(candidate.get("id")) == requested_plan_id
            ),
            None,
        )
        if plan is None:
            plan = next(
                (
                    candidate for candidate in plans
                    if isinstance(candidate, dict) and candidate.get("is_default") is True
                ),
                None,
            )
        if not isinstance(plan, dict):
            raise ValueError(
                f"dataset_manifest.json does not contain training plan {requested_plan_id or 'default'}"
            )
        selections = plan.get("selections")
        if not isinstance(selections, list):
            raise ValueError("The selected package-v2 training plan does not contain selections")
        selections_by_id = {
            str(selection.get("asset_id")): selection
            for selection in selections
            if isinstance(selection, dict) and first_string(selection.get("asset_id"))
        }

        selected: list[dict[str, Any]] = []
        selected_ids: set[str] = set()
        for clip in clips:
            if not isinstance(clip, dict) or clip.get("include_in_training") is False:
                continue
            asset_id = first_string(clip.get("asset_id"), clip.get("id"))
            if not asset_id:
                raise ValueError("Package-v2 training bundle contains an entry without asset_id")
            asset = assets_by_id.get(asset_id)
            if asset is None:
                raise ValueError(f"Training bundle references unknown package-v2 asset {asset_id}")
            role = first_string(asset.get("asset_role"), clip.get("asset_role"))
            if not role:
                raise ValueError(f"Package-v2 asset {asset_id} does not declare asset_role")
            if includes and role.lower() not in includes:
                continue
            selection = selections_by_id.get(asset_id)
            if selection is None:
                raise ValueError(
                    f"Package-v2 asset {asset_id} is missing from training plan {plan.get('id', 'unknown')}"
                )
            file_record = asset.get("file") if isinstance(asset.get("file"), dict) else {}
            file_path = first_string(file_record.get("path"))
            if not file_path:
                raise ValueError(f"Package-v2 asset {asset_id} does not declare file.path")

            source_range = asset.get("source_range") if isinstance(asset.get("source_range"), dict) else {}
            training_range = (
                selection.get("training_range")
                if isinstance(selection.get("training_range"), dict)
                else {}
            )
            self.validate_training_range(asset_id, source_range, training_range)
            annotation = asset.get("annotation") if isinstance(asset.get("annotation"), dict) else {}
            caption_record = annotation.get("caption") if isinstance(annotation.get("caption"), dict) else {}
            lyrics_record = annotation.get("lyrics") if isinstance(annotation.get("lyrics"), dict) else {}

            normalized = dict(clip)
            normalized.update({
                "id": asset_id,
                "asset_id": asset_id,
                "asset_role": role,
                "source_track_id": first_string(asset.get("source_track_id")),
                "file": file_path,
                "assets": {role: file_path},
                "source_range": source_range,
                "training_range": training_range,
                "range_policy": first_string(selection.get("range_policy")),
                "sample_window_seconds": first_number(selection.get("sample_window_seconds")),
                "include_in_training": True,
                "annotation": annotation,
            })
            normalized["caption"] = first_string(
                caption_record.get("text"),
                clip.get("caption"),
                clip.get("prompt"),
                asset_id,
            )
            normalized["lyrics"] = first_string(
                lyrics_record.get("text"),
                clip.get("lyrics"),
                clip.get("transcript"),
            )
            language = first_string(caption_record.get("language"), lyrics_record.get("language"))
            if language:
                normalized["language"] = language
            selected.append(normalized)
            selected_ids.add(asset_id)

        if not selected:
            roles = ", ".join(includes) if includes else "the selected roles"
            raise ValueError(f"Package-v2 training plan contains no assets for {roles}")

        return selected, {
            "source_package_version": version,
            "dataset_manifest": relative_path(manifest_path, self.package_root),
            "training_plan_id": first_string(plan.get("id")),
            "asset_roles": sorted({
                str(clip.get("asset_role")) for clip in selected
            }),
            "asset_ids": sorted(selected_ids),
            "training_ranges": [
                {
                    "asset_id": str(clip.get("asset_id")),
                    **(clip.get("training_range") or {}),
                    "range_policy": clip.get("range_policy"),
                }
                for clip in selected
            ],
        }

    def validate_training_range(
        self,
        asset_id: str,
        source_range: dict[str, Any],
        training_range: dict[str, Any],
    ) -> None:
        start = first_number(training_range.get("start_seconds"))
        end = first_number(training_range.get("end_seconds"))
        source_start = first_number(source_range.get("start_seconds")) or 0.0
        source_end = first_number(source_range.get("end_seconds"))
        if start is None or end is None:
            raise ValueError(f"Package-v2 asset {asset_id} requires an explicit training_range")
        if start < source_start - 0.001 or end <= start:
            raise ValueError(f"Package-v2 asset {asset_id} has an invalid training_range")
        if source_end is not None and end > source_end + 0.001:
            raise ValueError(
                f"Package-v2 asset {asset_id} training_range exceeds its source_range"
            )
        if end - start > MAX_CLIP_DURATION_SECONDS + 0.001:
            raise ValueError(
                f"Package-v2 asset {asset_id} training_range exceeds ACE-Step's "
                f"{int(MAX_CLIP_DURATION_SECONDS)} second limit"
            )

    def make_sidestep_dataset(self) -> dict[str, Any]:
        bundle_path = self.selected_bundle_path()
        bundle = read_json(bundle_path)
        clips, selection = self.selected_clips(bundle, bundle_path)
        self.dataset_selection = selection

        package = self.job.get("package") if isinstance(self.job.get("package"), dict) else {}
        training = self.job.get("training") if isinstance(self.job.get("training"), dict) else {}
        selected = package.get("selected_bundle") if isinstance(package.get("selected_bundle"), dict) else {}
        includes = self.selected_include()
        bundle_name = selected.get("name") or bundle_path.stem
        training_lyrics = first_string(selected.get("training_lyrics"), bundle.get("training_lyrics"))
        force_instrumental = (
            "instrumental" in [item.lower() for item in includes]
            or training_lyrics == "[Instrumental]"
        )

        samples: list[dict[str, Any]] = []
        missing_audio: list[str] = []
        if self.preprocess_audio_dir.exists():
            shutil.rmtree(self.preprocess_audio_dir)
        self.preprocess_audio_dir.mkdir(parents=True, exist_ok=True)
        for index, clip in enumerate(clips):
            if not isinstance(clip, dict):
                continue
            assets = clip.get("assets") if isinstance(clip.get("assets"), dict) else {}
            analysis = clip.get("analysis") if isinstance(clip.get("analysis"), dict) else {}
            rel_audio = first_string(clip.get("file"))
            if not rel_audio:
                for include in includes:
                    rel_audio = first_string(assets.get(include))
                    if rel_audio:
                        break
            rel_audio = rel_audio or first_string(
                assets.get("full_mix"),
                assets.get("instrumental"),
                assets.get("vocals"),
                clip.get("id"),
            )
            if not rel_audio:
                missing_audio.append(str(clip.get("id", index)))
                continue
            audio_path = resolve_package_path(self.package_root, rel_audio, f"clip[{index}].audio_path")
            if not audio_path.exists():
                missing_audio.append(rel_audio)
                continue
            training_range = (
                clip.get("training_range")
                if isinstance(clip.get("training_range"), dict)
                else {}
            )
            source_range = (
                clip.get("source_range")
                if isinstance(clip.get("source_range"), dict)
                else {}
            )
            staged_audio_path = self.stage_preprocess_audio(
                index,
                clip,
                rel_audio,
                audio_path,
                source_range=source_range,
                training_range=training_range,
            )

            caption = first_string(clip.get("caption"), clip.get("prompt"), clip.get("id"), audio_path.stem)
            lyrics = "[Instrumental]" if force_instrumental else first_string(
                clip.get("lyrics"),
                clip.get("transcript"),
                training_lyrics,
                "[Instrumental]",
            )
            if not lyrics:
                lyrics = "[Instrumental]"
            duration = first_number(
                (
                    first_number(training_range.get("end_seconds"))
                    - first_number(training_range.get("start_seconds"))
                )
                if first_number(training_range.get("end_seconds")) is not None
                and first_number(training_range.get("start_seconds")) is not None
                else None,
                clip.get("duration"),
                analysis.get("duration_seconds"),
                clip.get("seconds_total"),
            )
            bpm = first_number(clip.get("bpm"), analysis.get("tempo_bpm_estimate"))
            keyscale = first_string(clip.get("keyscale"), clip.get("key"), analysis.get("keyscale"))
            sample: dict[str, Any] = {
                "id": str(clip.get("id") or f"clip-{index + 1:04d}"),
                "asset_id": first_string(clip.get("asset_id"), clip.get("id")),
                "asset_role": first_string(clip.get("asset_role")),
                "source_track_id": first_string(clip.get("source_track_id")),
                "audio_path": staged_audio_path.as_posix(),
                "filename": staged_audio_path.name,
                "source_audio_path": audio_path.as_posix(),
                "source_filename": audio_path.name,
                "caption": caption,
                "genre": caption,
                "lyrics": lyrics,
                "raw_lyrics": first_string(clip.get("raw_lyrics"), clip.get("transcript"), lyrics) or lyrics,
                "formatted_lyrics": lyrics,
                "bpm": bpm if bpm is not None else "N/A",
                "keyscale": keyscale or "N/A",
                "timesignature": first_string(clip.get("timesignature"), clip.get("time_signature"), "4/4"),
                "duration": duration if duration is not None else 0,
                "language": first_string(
                    clip.get("language"),
                    (clip.get("annotation") or {}).get("language") if isinstance(clip.get("annotation"), dict) else None,
                    "en",
                ),
                "is_instrumental": lyrics.strip() == "[Instrumental]",
                "custom_tag": "",
                "labeled": True,
                "prompt_override": "caption",
                "source_range": source_range or None,
                "training_range": training_range or None,
                "range_policy": first_string(clip.get("range_policy")),
                "sample_window_seconds": first_number(clip.get("sample_window_seconds")),
            }
            samples.append(sample)

        if missing_audio:
            preview = ", ".join(missing_audio[:8])
            raise FileNotFoundError(
                f"{len(missing_audio)} clip audio file(s) are missing from the package. First missing: {preview}"
            )
        if not samples:
            raise ValueError("No usable samples were found in the selected training bundle")

        dataset = {
            "metadata": {
                "name": str(training.get("adapter_name") or package.get("package_name") or "pimp_remote_dataset"),
                "custom_tag": "",
                "tag_position": "prepend",
                "created_at": utc_now(),
                "num_samples": len(samples),
                "all_instrumental": all(sample["is_instrumental"] for sample in samples),
                "genre_ratio": 0,
                "source_bundle": str(bundle_name),
                "source_package_version": selection.get("source_package_version"),
                "training_plan_id": selection.get("training_plan_id"),
                "selected_asset_roles": selection.get("asset_roles", []),
                "pimp_audio_remote_job_id": self.job.get("job_id"),
            },
            "samples": samples,
        }
        write_json(self.side_step_dataset, dataset)
        self.log(
            "dataset",
            "Wrote Side-Step dataset JSON",
            samples=len(samples),
            bundle=Path(bundle_path).name,
            path=relative_path(self.side_step_dataset, self.package_root),
        )
        self.metric(stage="dataset", sample_count=len(samples))
        return dataset

    def stage_preprocess_audio(
        self,
        index: int,
        clip: dict[str, Any],
        rel_audio: str,
        source: Path,
        *,
        source_range: dict[str, Any],
        training_range: dict[str, Any],
    ) -> Path:
        source_label = Path(str(clip.get("id") or rel_audio)).stem
        staged_stem = f"{index + 1:04d}-{safe_name(source_label)}"
        start = first_number(training_range.get("start_seconds"))
        end = first_number(training_range.get("end_seconds"))
        source_start = first_number(source_range.get("start_seconds")) or 0.0
        source_end = first_number(source_range.get("end_seconds"))
        needs_crop = (
            start is not None
            and end is not None
            and (
                abs(start - source_start) > 0.001
                or source_end is None
                or abs(end - source_end) > 0.001
            )
        )
        suffix = ".wav" if needs_crop and not self.args.dry_run else (source.suffix.lower() or ".wav")
        staged_path = self.preprocess_audio_dir / f"{staged_stem}{suffix}"
        if staged_path.exists() or staged_path.is_symlink():
            staged_path.unlink()
        if needs_crop and not self.args.dry_run:
            ffmpeg = shutil.which("ffmpeg")
            if not ffmpeg:
                raise FileNotFoundError(
                    f"ffmpeg is required to materialize the training range for {clip.get('id', rel_audio)}"
                )
            duration = end - start
            subprocess.run(
                [
                    ffmpeg,
                    "-hide_banner",
                    "-loglevel",
                    "error",
                    "-y",
                    "-ss",
                    f"{start:.6f}",
                    "-i",
                    str(source),
                    "-t",
                    f"{duration:.6f}",
                    "-map",
                    "0:a:0",
                    "-vn",
                    "-c:a",
                    "pcm_s24le",
                    str(staged_path),
                ],
                check=True,
            )
            return staged_path
        try:
            staged_path.symlink_to(source)
        except OSError:
            try:
                os.link(source, staged_path)
            except OSError:
                shutil.copy2(source, staged_path)
        return staged_path

    def env_paths(self) -> tuple[Path, Path, Path]:
        workdir = Path(os.environ.get("PIMP_REMOTE_WORKDIR", str(DEFAULT_WORKDIR))).expanduser()
        ace_dir = Path(os.environ.get("PIMP_ACE_DIR", str(workdir / "ACE-Step-1.5"))).expanduser()
        checkpoints = Path(os.environ.get("PIMP_CHECKPOINT_DIR", str(workdir / "checkpoints"))).expanduser()
        python = preferred_worker_python(workdir)
        return ace_dir.resolve(), checkpoints.resolve(), python

    def ensure_environment(self, variant: str) -> tuple[Path, Path, Path]:
        ace_dir, checkpoints, python = self.env_paths()
        train_py = ace_dir / "train.py"
        if not train_py.exists():
            raise FileNotFoundError(
                f"ACE-Step training source not found at {train_py}. "
                "Run remote-worker/install.sh on the pod first."
            )
        if not python.exists():
            raise FileNotFoundError(
                f"Worker Python not found at {python}. Run remote-worker/install.sh on the pod first."
            )
        checkpoints.mkdir(parents=True, exist_ok=True)
        if not self.args.no_download and os.environ.get("PIMP_REMOTE_DOWNLOAD_MODELS", "1") != "0":
            self.ensure_model_assets(python, ace_dir, checkpoints, variant)
        self.ensure_ace_compatibility_patches(ace_dir)
        return ace_dir, checkpoints, python

    def ensure_ace_compatibility_patches(self, ace_dir: Path) -> None:
        fixed_module = ace_dir / "acestep/training_v2/fixed_lora_module.py"
        if fixed_module.is_file():
            text = fixed_module.read_text(encoding="utf-8")
            if "PIMP_REMOTE_TRAINING_PRECISION" not in text:
                text = text.replace(
                    "def _select_compute_dtype(device_type: str) -> torch.dtype:\n"
                    "    if device_type in (\"cuda\", \"xpu\"):\n"
                    "        return torch.bfloat16\n"
                    "    if device_type == \"mps\":\n"
                    "        return torch.float16\n"
                    "    return torch.float32\n",
                    "def _select_compute_dtype(device_type: str) -> torch.dtype:\n"
                    "    import os\n"
                    "    requested = os.environ.get(\"PIMP_REMOTE_TRAINING_PRECISION\", \"\").lower()\n"
                    "    if requested == \"fp16\":\n"
                    "        return torch.float16\n"
                    "    if requested == \"fp32\":\n"
                    "        return torch.float32\n"
                    "    if requested == \"bf16\":\n"
                    "        return torch.bfloat16\n"
                    "    if device_type in (\"cuda\", \"xpu\"):\n"
                    "        return torch.bfloat16\n"
                    "    if device_type == \"mps\":\n"
                    "        return torch.float16\n"
                    "    return torch.float32\n",
                )
                text = text.replace(
                    "def _select_fabric_precision(device_type: str) -> str:\n"
                    "    if device_type in (\"cuda\", \"xpu\"):\n"
                    "        return \"bf16-mixed\"\n"
                    "    if device_type == \"mps\":\n"
                    "        return \"16-mixed\"\n"
                    "    return \"32-true\"\n",
                    "def _select_fabric_precision(device_type: str) -> str:\n"
                    "    import os\n"
                    "    requested = os.environ.get(\"PIMP_REMOTE_TRAINING_PRECISION\", \"\").lower()\n"
                    "    if requested == \"fp16\":\n"
                    "        return \"16-mixed\"\n"
                    "    if requested == \"fp32\":\n"
                    "        return \"32-true\"\n"
                    "    if requested == \"bf16\":\n"
                    "        return \"bf16-mixed\"\n"
                    "    if device_type in (\"cuda\", \"xpu\"):\n"
                    "        return \"bf16-mixed\"\n"
                    "    if device_type == \"mps\":\n"
                    "        return \"16-mixed\"\n"
                    "    return \"32-true\"\n",
                )
                fixed_module.write_text(text, encoding="utf-8")
                self.log("setup", "Applied ACE fixed trainer precision compatibility patch", path=str(fixed_module))

        trainer_fixed = ace_dir / "acestep/training_v2/trainer_fixed.py"
        if trainer_fixed.is_file():
            text = trainer_fixed.read_text(encoding="utf-8")
            clip_call = (
                "                    self.fabric.clip_gradients(\n"
                "                        self.module.model.decoder, optimizer, max_norm=cfg.max_grad_norm,\n"
                "                    )\n"
            )
            guarded_clip_call = (
                "                    if cfg.max_grad_norm and cfg.max_grad_norm > 0 and cfg.precision != \"fp16\":\n"
                "                        self.fabric.clip_gradients(\n"
                "                            self.module.model.decoder, optimizer, max_norm=cfg.max_grad_norm,\n"
                "                        )\n"
            )
            if clip_call in text and guarded_clip_call not in text:
                text = text.replace(clip_call, guarded_clip_call)
                trainer_fixed.write_text(text, encoding="utf-8")
                self.log("setup", "Applied ACE fp16 gradient-clipping compatibility patch", path=str(trainer_fixed))

