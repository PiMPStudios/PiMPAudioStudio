            str(shift),
            "--num-inference-steps",
            str(inference_steps),
            "--optimizer-type",
            "adamw",
            "--scheduler-type",
            "cosine",
            "--num-workers",
            str(num_workers),
            "--prefetch-factor",
            str(prefetch_factor),
            "--persistent-workers" if num_workers > 0 else "--no-persistent-workers",
            "--log-dir",
            str(self.output_dir / "runs"),
            "--log-every",
            "10",
            "--log-heavy-every",
            "50",
            "--cfg-ratio",
            str(cfg_ratio),
        ]
        if adapter_type == "lokr":
            train_cmd.extend([
                "--lokr-linear-dim",
                str(coerce_int(training.get("lokr_linear_dim"), 32)),
                "--lokr-linear-alpha",
                str(coerce_int(training.get("lokr_linear_alpha"), 64)),
            ])
            if bool(training.get("lokr_weight_decompose", True)):
                train_cmd.append("--lokr-weight-decompose")
        else:
            train_cmd.extend([
                "--rank",
                str(int(training.get("rank") or 64)),
                "--alpha",
                str(int(training.get("alpha") or 64)),
                "--dropout",
                str(float(training.get("dropout") or 0.0)),
            ])

        command_cwd = self.command_cwd(ace_dir, checkpoints)
        self.write_command_script("preprocess.sh", preprocess_cmd, cwd=command_cwd)
        self.write_command_script("train.sh", train_cmd, cwd=command_cwd)
        return preprocess_cmd, train_cmd

    def write_command_script(self, name: str, command: list[str], cwd: Path) -> None:
        path = self.command_dir / name
        path.write_text(
            "#!/usr/bin/env bash\n"
            "set -euo pipefail\n"
            f"cd {shlex.quote(str(cwd))}\n"
            f"exec {shell_join(command)}\n",
            encoding="utf-8",
        )
        path.chmod(0o755)

    def run_command(self, stage: str, command: list[str], cwd: Path) -> None:
        self.log(stage, "Starting command", command=shell_join(command), cwd=cwd.as_posix())
        start = time.time()
        failure_line: str | None = None
        env = os.environ.copy()
        if "--precision" in command:
            precision_index = command.index("--precision") + 1
            if precision_index < len(command):
                env["PIMP_REMOTE_TRAINING_PRECISION"] = str(command[precision_index])
        process = subprocess.Popen(
            command,
            cwd=str(cwd),
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
            env=env,
        )
        assert process.stdout is not None
        for line in process.stdout:
            line = line.rstrip()
            if line:
                self.log(stage, line)
                self.extract_metric(line)
                if line.startswith("[FAIL]") or "TRAINING FAILED" in line:
                    failure_line = line
        rc = process.wait()
        elapsed = time.time() - start
        self.metric(stage=stage, elapsed_seconds=elapsed, return_code=rc)
        if rc != 0:
            raise subprocess.CalledProcessError(rc, command)
        if failure_line:
            raise RuntimeError(f"{stage} reported failure: {failure_line}")
        self.log(stage, "Command finished", elapsed_seconds=round(elapsed, 2))

    def extract_metric(self, line: str) -> None:
        lower = line.lower()
        if "loss" not in lower and "lr" not in lower:
            return
        fields: dict[str, Any] = {"stage": "training_log"}
        step = re.search(r"\bstep[=: ]+(\d+)", lower)
        epoch = re.search(r"\bepoch[=: ]+(\d+)", lower)
        loss = re.search(r"\bloss[=: ]+([0-9]+(?:\.[0-9]+)?(?:e[-+]?\d+)?)", lower)
        lr = re.search(r"\blr[=: ]+([0-9]+(?:\.[0-9]+)?(?:e[-+]?\d+)?)", lower)
        if step:
            fields["step"] = int(step.group(1))
        if epoch:
            fields["epoch"] = int(epoch.group(1))
        if loss:
            fields["loss"] = float(loss.group(1))
        if lr:
            fields["lr"] = float(lr.group(1))
        if len(fields) > 1:
            self.metric(**fields)

    def count_tensors(self) -> int:
        if not self.tensor_dir.exists():
            return 0
        return len(list(self.tensor_dir.glob("*.pt")))

    def cache_fingerprint_path(self) -> Path:
        return self.tensor_dir / "cache_fingerprint.json"

    def preprocessing_fingerprint(
        self,
        dataset: dict[str, Any],
        *,
        variant: str,
        precision: str,
        max_duration: int,
    ) -> dict[str, Any]:
        samples: list[dict[str, Any]] = []
        for sample in dataset.get("samples") or []:
            if not isinstance(sample, dict):
                continue
            source = Path(str(sample.get("source_audio_path") or ""))
            samples.append(
                {
                    "id": sample.get("id"),
                    "asset_id": sample.get("asset_id"),
                    "asset_role": sample.get("asset_role"),
                    "caption": sample.get("caption"),
                    "lyrics": sample.get("lyrics"),
                    "duration": sample.get("duration"),
                    "training_range": sample.get("training_range"),
                    "source_range": sample.get("source_range"),
                    "source_filename": sample.get("source_filename"),
                    "audio_sha256": file_sha256(source) if source.is_file() else "",
                }
            )
        return {
            "schema_version": 1,
            "variant": variant,
            "preprocess_precision": precision,
            "max_duration": max_duration,
            "samples": samples,
        }

    def read_cache_fingerprint(self) -> dict[str, Any] | None:
        path = self.cache_fingerprint_path()
        if not path.is_file():
            return None
        try:
            payload = read_json(path)
        except (OSError, json.JSONDecodeError, TypeError, ValueError):
            return None
        return payload if isinstance(payload, dict) else None

    def write_cache_fingerprint(self, fingerprint: dict[str, Any]) -> None:
        self.tensor_dir.mkdir(parents=True, exist_ok=True)
        write_json(self.cache_fingerprint_path(), fingerprint)

    def fingerprints_match(self, expected: dict[str, Any], stored: dict[str, Any] | None) -> bool:
        if stored is None:
            return False
        return json.loads(json.dumps(expected, sort_keys=True, default=str)) == json.loads(
            json.dumps(stored, sort_keys=True, default=str)
        )

    def has_adapter_weights(self, directory: Path) -> bool:
        if not directory.is_dir():
            return False
        return any(directory.rglob("*.safetensors"))

    def tensor_cache_health(self, repair: bool = False) -> tuple[bool, str, int]:
        if not self.tensor_dir.exists():
            return False, "tensor directory is missing", 0
        tensor_paths = sorted(self.tensor_dir.glob("*.pt"))
        if not tensor_paths:
            return False, "no tensor files found", 0
        try:
            import torch
        except Exception as exc:
            return False, f"torch unavailable for tensor validation: {exc}", len(tensor_paths)

        checked_keys = {
            "target_latents",
            "attention_mask",
            "encoder_hidden_states",
            "encoder_attention_mask",
            "context_latents",
        }
        max_repair_fraction = float(os.environ.get("PIMP_REMOTE_TENSOR_REPAIR_MAX_FRACTION", "0.001"))
        repaired_files = 0
        repaired_values = 0
        for path in tensor_paths:
            try:
                payload = torch.load(path, map_location="cpu", weights_only=True)
            except TypeError:
                payload = torch.load(path, map_location="cpu")
            except Exception as exc:
                return False, f"{path.name} could not be loaded: {exc}", len(tensor_paths)
            if not isinstance(payload, dict):
                return False, f"{path.name} is not a tensor payload", len(tensor_paths)
            changed = False
            for key in checked_keys:
                value = payload.get(key)
                if value is None:
                    return False, f"{path.name} is missing {key}", len(tensor_paths)
                if torch.is_tensor(value):
                    finite = torch.isfinite(value)
                    if not finite.all().item():
                        nonfinite_count = int((~finite).sum().item())
                        total_count = max(int(value.numel()), 1)
                        fraction = nonfinite_count / total_count
                        if not repair or fraction > max_repair_fraction:
                            return (
                                False,
                                f"{path.name} contains {nonfinite_count} non-finite values in {key} ({fraction:.4%})",
                                len(tensor_paths),
                            )
                        payload[key] = torch.nan_to_num(value, nan=0.0, posinf=0.0, neginf=0.0)
                        repaired_values += nonfinite_count
                        changed = True
            if changed:
                torch.save(payload, path)
                repaired_files += 1
        if repaired_values > 0:
            return True, f"repaired {repaired_values} non-finite tensor values across {repaired_files} files", len(tensor_paths)
        return True, "tensor cache is finite", len(tensor_paths)

    def copy_outputs(self) -> dict[str, float]:
        src_final = self.output_dir / "final"
        src_checkpoints = self.output_dir / "checkpoints"
        if not self.has_adapter_weights(src_final):
            raise RuntimeError("Training completed without a final adapter")
        if self.final_adapter_dir.exists():
            shutil.rmtree(self.final_adapter_dir)
        shutil.copytree(src_final, self.final_adapter_dir)
        if src_checkpoints.exists():
            if self.checkpoints_dir.exists():
                shutil.rmtree(self.checkpoints_dir)
            shutil.copytree(src_checkpoints, self.checkpoints_dir)
        else:
            self.checkpoints_dir.mkdir(parents=True, exist_ok=True)
        final_files = list(self.final_adapter_dir.rglob("*")) if self.final_adapter_dir.exists() else []
        checkpoint_count = (
            len([path for path in self.checkpoints_dir.iterdir() if path.is_dir()])
            if self.checkpoints_dir.exists()
            else 0
        )
        return {
            "tensor_count": float(self.count_tensors()),
            "final_file_count": float(len([path for path in final_files if path.is_file()])),
            "checkpoint_count": float(checkpoint_count),
        }

    def train(self) -> int:
        self.started_at = utc_now()
        try:
            self.log("setup", "Loaded remote job", job=str(self.job_path), package_root=str(self.package_root))
            _ace_dir, _checkpoints, worker_python = self.env_paths()
            self.log(
                "setup",
                "Resolved worker Python",
                executable=sys.executable,
                worker_python=str(worker_python),
                env_python=os.environ.get("PIMP_REMOTE_PYTHON", ""),
            )
            dataset = self.make_sidestep_dataset()
            preprocess_cmd, train_cmd = self.build_commands()
            training = self.job.get("training") if isinstance(self.job.get("training"), dict) else {}
            variant = normalize_variant(
                first_string(training.get("worker_model_variant"), training.get("base_model_id"))
            )
            ace_dir, checkpoints, _python = self.ensure_environment(variant) if not self.args.dry_run else self.env_paths()
            command_cwd = self.command_cwd(ace_dir, checkpoints)
            dry_run_payload = {
                "job": str(self.job_path),
                "package_root": str(self.package_root),
                "side_step_dataset": str(self.side_step_dataset),
                "sample_count": len(dataset.get("samples", [])),
                "package_v2_selection": self.dataset_selection,
                "command_cwd": str(command_cwd),
                "preprocess_precision": preprocess_cmd[preprocess_cmd.index("--precision") + 1],
                "training_precision": train_cmd[train_cmd.index("--precision") + 1],
                "preprocess_command": preprocess_cmd,
                "train_command": train_cmd,
            }
            write_json(self.command_dir / "dry_run.json", dry_run_payload)
            if self.args.dry_run:
                self.log("dry_run", "Dry run complete; training was not started")
                self.write_result(
                    "succeeded",
                    metrics={"sample_count": float(len(dataset.get("samples", []))), "dry_run": 1.0},
                    extra_artifacts=[
                        {
                            "kind": "side_step_dataset",
                            "path": relative_path(self.side_step_dataset, self.package_root),
                            "media_type": "application/json",
                        }
                    ],
                )
                return 0

            cache_ok, cache_reason, tensor_count = self.tensor_cache_health(repair=True)
            force_preprocess = os.environ.get("PIMP_REMOTE_FORCE_PREPROCESS", "0") == "1"
            expected_fingerprint = self.preprocessing_fingerprint(
                dataset,
                variant=preprocess_cmd[preprocess_cmd.index("--model-variant") + 1],
                precision=preprocess_cmd[preprocess_cmd.index("--precision") + 1],
                max_duration=int(preprocess_cmd[preprocess_cmd.index("--max-duration") + 1]),
            )
            cache_matches = self.fingerprints_match(expected_fingerprint, self.read_cache_fingerprint())
            if cache_ok and cache_matches and not force_preprocess:
                if cache_reason != "tensor cache is finite":
                    self.log("preprocess", "Repaired preprocessed tensor cache", tensor_count=tensor_count, reason=cache_reason)
                self.log("preprocess", "Reusing existing preprocessed tensors", tensor_count=tensor_count)
            else:
                discard_reason = (
                    "forced" if force_preprocess else ("fingerprint mismatch" if cache_ok else cache_reason)
                )
                if self.tensor_dir.exists() and tensor_count > 0:
                    self.log(
                        "preprocess",
                        "Discarding preprocessed tensor cache",
                        tensor_count=tensor_count,
                        reason=discard_reason,
                    )
                if self.tensor_dir.exists():
                    shutil.rmtree(self.tensor_dir)
                self.tensor_dir.mkdir(parents=True, exist_ok=True)
                self.preprocess_placeholder.mkdir(parents=True, exist_ok=True)
                self.run_command("preprocess", preprocess_cmd, cwd=command_cwd)
                cache_ok, cache_reason, tensor_count = self.tensor_cache_health(repair=True)
                if cache_ok and cache_reason != "tensor cache is finite":
                    self.log("preprocess", "Repaired preprocessed tensor cache", tensor_count=tensor_count, reason=cache_reason)
                if cache_ok:
                    self.write_cache_fingerprint(expected_fingerprint)
            if not cache_ok:
                raise RuntimeError(f"Preprocessing did not produce a usable tensor cache: {cache_reason}")
            self.metric(stage="preprocess", tensor_count=tensor_count)

            if str(self.job.get("task") or "") == "preprocess":
                self.log("complete", "Preprocessing complete", tensor_count=tensor_count)
                self.write_result(
                    "succeeded",
                    metrics={
                        "tensor_count": float(tensor_count),
                        "sample_count": float(len(dataset.get("samples", []))),
                    },
                    extra_artifacts=[
                        {
                            "kind": "tensors",
                            "path": relative_path(self.tensor_dir, self.package_root),
                            "media_type": "inode/directory",
                        },
                        {
                            "kind": "side_step_dataset",
                            "path": relative_path(self.side_step_dataset, self.package_root),
                            "media_type": "application/json",
                        },
                    ],
                    include_training_artifacts=False,
                )
                return 0

            if self.output_dir.exists():
                shutil.rmtree(self.output_dir)
            self.output_dir.mkdir(parents=True, exist_ok=True)
            self.run_command("train", train_cmd, cwd=command_cwd)
            metrics = self.copy_outputs()
            metrics["sample_count"] = float(len(dataset.get("samples", [])))
            self.log("complete", "Training complete", metrics=metrics)
            self.write_result("succeeded", metrics=metrics)
            return 0
        except Exception as exc:
            self.log("error", str(exc), level="error")
            self.write_result(
                "failed",
                error={
                    "code": exc.__class__.__name__,
                    "message": str(exc),
                    "recoverable": True,
                },
            )
            return 1


def command_doctor(_args: argparse.Namespace) -> int:
    workdir = Path(os.environ.get("PIMP_REMOTE_WORKDIR", str(DEFAULT_WORKDIR))).expanduser()
    ace_dir = Path(os.environ.get("PIMP_ACE_DIR", str(workdir / "ACE-Step-1.5"))).expanduser()
    python = preferred_worker_python(workdir)
    checkpoints = Path(os.environ.get("PIMP_CHECKPOINT_DIR", str(workdir / "checkpoints"))).expanduser()
    print(f"pimp-remote-worker {VERSION}")
    print(f"executable: {sys.executable}")
    print(f"workdir: {workdir}")
    print(f"ace_dir: {ace_dir} ({'ok' if (ace_dir / 'train.py').exists() else 'missing train.py'})")
    print(f"python: {python} ({'ok' if python.exists() else 'missing'})")
    print(f"checkpoints: {checkpoints}")
    if python.exists():
        try:
            subprocess.run([str(python), "-c", "import torch; print('torch', torch.__version__); print('cuda', torch.cuda.is_available()); print('gpu', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'none')"], check=False)
        except OSError as exc:
            print(f"python probe failed: {exc}")
    return 0


def command_train(args: argparse.Namespace) -> int:
    return RemoteWorker(args).train()


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="pimp-remote-worker")
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)
    doctor = sub.add_parser("doctor", help="Check worker environment")
    doctor.set_defaults(func=command_doctor)
    train = sub.add_parser("train", help="Run a PiMP Audio Studio remote job")
    train.add_argument("job", help="remote_job.json, package directory, or exported job zip")
    train.add_argument("--dry-run", action="store_true", help="Validate package and write commands without downloading models or training")
    train.add_argument("--no-download", action="store_true", help="Do not download missing ACE-Step model assets")
    train.set_defaults(func=command_train)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
